# =============================================================================
# AgriVil / Golden Acres — Environment Variables Template
# =============================================================================

# --- Supabase Configuration ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- PostgreSQL Connection String ---
# Supabase Transaction Pooler (Port 6543):
DATABASE_URL=postgresql://postgres.your-project:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# --- Better Auth ---
BETTER_AUTH_SECRET=your-32-byte-secret-key
BETTER_AUTH_URL=http://localhost:3000

# --- Optional Integrations ---
# RESEND_API_KEY=re_...
# PAYSTACK_SECRET_KEY=sk_...
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_...
# STRIPE_SECRET_KEY=sk_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...
